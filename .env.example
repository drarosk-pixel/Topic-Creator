# ==========================================================================
# Topic-Creator — configuration
# Copy this file to `.env` and fill in the values. Never commit `.env`.
# ==========================================================================

# --- Telegram API credentials (from https://my.telegram.org -> API development tools)
# These belong to YOUR account and are used to log the userbot in.
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef

# --- Bot token (from @BotFather). This is the control panel you chat with.
BOT_TOKEN=123456789:AAExampleBotTokenReplaceMe

# --- Your Telegram numeric user id (from @userinfobot).
# Only this user is allowed to control the bot. Required for security.
OWNER_ID=111111111

# --- Optional tuning -------------------------------------------------------
# Seconds between progress-bar edits (avoid Telegram flood limits). Default 2.5
PROGRESS_EDIT_INTERVAL=2.5
# Starting pause (seconds) between copies. The bot auto-tunes from here: it
# slows down when Telegram throttles (FloodWait) and speeds back up when calm.
# Lower = faster but more FloodWaits; higher = steadier. Default 1.0
COPY_DELAY=1.0
# Directory where the userbot session string is stored. Default ./sessions
SESSIONS_DIR=sessions
